  "dependencies": {"bcryptjs": "3.0.3", "cors": "2.8.5", "express": "5.2.1", "express-rate-limit": "8.7.0", "helmet": "^8.1.0", "jsonwebtoken": "9.0.2", "mongoose": "9.10.4", "zod": "4.6.5"},
  "devDependencies": {"@eslint/js": "^9.39.0", "eslint": "^9.39.0", "globals": "^16.4.0", "mongodb-memory-server": "11.3.0", "supertest": "^7.2.2"}
}
