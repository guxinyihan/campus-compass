# Generate distinct secrets and a private demo admin password with scripts/init-env.py.
JWT_SECRET=
TRACKING_JWT_SECRET=
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=
DEMO_EMAIL=driver@example.test
DEMO_PASSWORD=
CORS_ORIGINS=http://localhost:5173
# Native service addresses; Compose supplies private network addresses itself.
MONGO_URI=mongodb://127.0.0.1:27017/campuscompass
GRAPHHOPPER_BASE_URL=http://127.0.0.1:8989
REDIS_ADDR=127.0.0.1:6379
VITE_API_URL=http://localhost:4000
VITE_ROUTING_API_URL=http://localhost:5001
VITE_TRACKING_API_URL=http://localhost:8081
VITE_TRACKING_WS_URL=ws://localhost:8081/ws/vehicles
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
